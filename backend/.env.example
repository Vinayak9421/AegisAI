# ==============================================================================
# Aegis AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# In production, never commit real secrets or credentials to source control.

# Application Environment (development, testing, staging, production)
APP_NAME="Aegis AI — Trust & Safety Red-Teaming Platform"
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aegis_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
DATABASE_SSL_MODE=prefer

# Authentication & Session Token Configuration
AUTH_SECRET=change_this_in_production_super_secret_key_minimum_32_bytes_long
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Encryption Key for Target Credentials Envelope Storage (32-byte hex string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
KEY_VERSION=v1

# Redis Configuration (Optional for Phase 1; Required for distributed worker queues in Phase 2)
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=aegis_jobs
WORKER_CONCURRENCY=4
LEASE_DURATION_SECONDS=300

# Target Connector Configuration
TARGET_CONNECT_TIMEOUT=10.0
TARGET_READ_TIMEOUT=30.0
TARGET_MAX_RESPONSE_BYTES=1048576
TARGET_DEFAULT_RATE_LIMIT=60
ALLOW_LOCAL_TARGETS_DEV=true
ALLOWED_EGRESS_DOMAINS=["api.openai.com", "api.groq.com", "api.anthropic.com"]

# Independent Judge & Multi-Key Fault-Tolerant Configuration
JUDGE_PROVIDER=groq
# Single key or comma-separated keys for auto-failover on rate limits (HTTP 429)
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
JUDGE_MODEL=qwen/qwen3.8-27b
JUDGE_TIMEOUT=30.0
JUDGE_RETRY_BUDGET=2

# Retention & Data Governance (Days)
RAW_EVIDENCE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
EXPORT_TTL_SECONDS=3600
